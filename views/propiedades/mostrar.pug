extends ../layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block contenido

    div(class="py-5")
        h1(id="titulo" class="text-4xl my-10 font-extrabold text-center")= propiedad.titulo

        div
            a(href="#" class="font-bold text-gray-600 text-lg") Categoria: 
                span(class="font-normal")= propiedad.categoria.nombre
    
        div(class="mt-5 md:flex md:gap-4 md:items-start")
            div(class="md:w-2/3 bg-white shadow rounded-lg")
                img(src=`/uploads/${propiedad.imagen}`, alt="imagen de la propiedad" class="object-contain w-full")

                div(class="px-5 py-10 space-y-5")
                    p=propiedad.descripcion
                    h2(class="text-2xl leading-6 font-bold text-gray-900") Informacion de la Propiedad

                    div(class="grid grid-cols-1 md:grid-cols-2")
                        p(class="text-gray-600 font-bold text-md")  BAÑOS
                            img(src="/img/icons/wc.png", alt="wc" class="w-5 h-5 inline-block ml-2 -mt-1")
                            span(class="text-gray-800 block text-lg")= propiedad.wc
                        p(class="text-gray-600 font-bold text-md") HABITACIONES
                            img(src="/img/icons/room.png", alt="wc" class="w-5 h-5 inline-block ml-2 -mt-1")
                            span(class="text-gray-800 block text-lg")= propiedad.habitaciones
                        p(class="text-gray-600 font-bold text-md") ESTACIONAMIENTO
                            img(src="/img/icons/garage.png", alt="wc" class="w-5 h-5 inline-block ml-2 -mt-1")
                            span(class="text-gray-800 block text-lg")= propiedad.estacionamiento
                        p(class="text-gray-600 font-bold text-md") PRECIO
                            img(src="/img/icons/dolar.png", alt="wc" class="w-5 h-5 inline-block ml-2 -mt-1")
                            span(class="text-gray-800 block text-lg")= propiedad.precio.nombre


            aside(class="md:w-1/3 bg-white shadow rounded-lg") 
                h3(class="text-center py-10 leading-6 text-2xl font-bold text-gray-900") Ubicacion 

                div(class="h-96" id="mapa")
                    p(class="hidden" id="lat")= propiedad.lat
                    p(class="hidden" id="lng")= propiedad.lng

                div(class="p-5")
                    p(class="text-gray-600 font-bold text-xs") Direccion
                        span(class="text-gray-800 block text-lg")= propiedad.calle
                    
                    if !esVendedor

                        h3(class="text-2xl text-center my-8 font-extrabold text-gray-900") Vendedor
                        if enviado
                            p(class="p-2 text-center bg-green-100 text-green-600 uppercase font-bold") Mensaje enviado correctamente 

                        else if usuario
                            if errores
                                div(class="max-w-md mx-auto my-10")
                                    each error in errores
                                        p.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold= error.msg
                            form(method="POST" href="#mensaje")
                                input(type="hidden" name="_csrf" value= csrfToken)

                                div(class="space-y-5")
                                    label(for="mensaje") Mensaje 
                                    textarea(id="mensaje" name="mensaje" class="w-full px-2 py-2 border border-gray-300 rounded-lg shadow placeholder-gray-400" placeholder="Escribe tu mensaje...")
                                    input(type="submit" value="Enviar Mensaje" class="bg-indigo-600 text-white font-bold uppercase text-sm w-full p-2 cursor-pointer" href="#vendedor")
                        else
                            div(class="flex flex-col items-center justify-center gap-2 ")
                                p(class="text-center") Si deseas contactar al vendedor
                                a(class="text-indigo-600 " href="/auth/crear-cuenta") debes crear una cuenta
                        


block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mostrarMapa.js") 